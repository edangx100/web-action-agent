# Copy to .env and fill in what you need. .env is gitignored; this template is
# committed, and it carries names and defaults only — never a key value.
#
# Configuration resolves in three layers, lowest precedence first:
#
#     config.yaml  →  .env  →  command-line flags
#
# config.yaml holds the checked-in defaults, this file holds machine-local
# overrides and every secret, and a flag beats both. Secrets live only here:
# an API key is never read from config.yaml.
#
# Every variable below is optional. Leave one unset and the config.yaml value
# stands. The commented default after each name is the one config.yaml ships.

# ---------------------------------------------------------------------------
# Endpoint selection
# ---------------------------------------------------------------------------
# The model endpoint is pure configuration: the same agent code runs against a
# hosted aggregator, a first-party provider endpoint, or a local vLLM server.
# A profile names a base URL, a model, and which variable below holds its key.

# Which profile the agent runs under: openrouter, nvidia, or local.
WAA_PROFILE=                      # default: openrouter

# One key per profile. Fill in only the profiles you actually use — the startup
# check reports which capabilities the keys you did set make available.
WAA_OPENROUTER_API_KEY=
WAA_NVIDIA_API_KEY=
WAA_LOCAL_API_KEY=                # a self-hosted vLLM server usually needs none

# Ad-hoc overrides of the selected profile's fields. Useful for pointing at a
# vLLM server on another host, or trying one model without editing config.yaml.
WAA_BASE_URL=
WAA_MODEL=
WAA_API_KEY=

# ---------------------------------------------------------------------------
# Judge endpoint
# ---------------------------------------------------------------------------
# Evaluation only. The judge must be a different, stronger model family than
# the planner — the agent is not graded by its own family. Running the agent
# needs no judge; reproducing the evaluation does.
WAA_JUDGE_PROFILE=
WAA_JUDGE_BASE_URL=
WAA_JUDGE_API_KEY=
WAA_JUDGE_MODEL=

# ---------------------------------------------------------------------------
# Agent loop
# ---------------------------------------------------------------------------
WAA_MAX_STEPS=                    # hard step cap per run
WAA_RETRY_BUDGET=                 # validator retries before the step fails

# Screenshots are cost-gated: they reach the planner only when the DOM signal
# is weak. These two are that heuristic's thresholds.
WAA_SCREENSHOT_MIN_ELEMENTS=      # gate in below this many interactive elements
WAA_SCREENSHOT_MAX_DOM_FAILURES=  # gate in after this many DOM-only failures

WAA_TEXT_TOKEN_BUDGET=            # truncation budget for the page-text extract

# ---------------------------------------------------------------------------
# Browser
# ---------------------------------------------------------------------------
WAA_VIEWPORT_WIDTH=               # default: 1280
WAA_VIEWPORT_HEIGHT=              # default: 800
WAA_DOMAIN_DELAY_S=               # default: 1.0 — politeness delay per domain

# Extra domains the allowlist accepts, comma-separated. The start URL's own
# registrable domain is always allowed and never needs listing here.
WAA_ALLOWLIST_EXTRA=

# ---------------------------------------------------------------------------
# Timeouts, in seconds. Each expiry is a categorized failure, not a crash.
# ---------------------------------------------------------------------------
WAA_ACTION_TIMEOUT_S=             # default: 30 — one browser action
WAA_LLM_TIMEOUT_S=                # default: 90 — one model call
WAA_RUN_TIMEOUT_S=                # default: 300 — one whole run

# ---------------------------------------------------------------------------
# Skill library
# ---------------------------------------------------------------------------
WAA_SKILL_RETIREMENT_RATE=        # default: 0.70 — retire below this success rate
WAA_SKILL_RETIREMENT_MIN_SAMPLE=  # uses required before retirement can trigger

# ---------------------------------------------------------------------------
# Evaluation harness
# ---------------------------------------------------------------------------
WAA_WORKERS=                      # default: 4 — parallel workers
WAA_BUDGET_USD=                   # default: 15 — spend ceiling for a sweep
WAA_BUDGET_HOURS=                 # default: 6 — wall-clock ceiling for a sweep
