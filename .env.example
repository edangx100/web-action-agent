# Copy to .env and fill in. .env is gitignored.
#
# The endpoint is pure configuration — the same code runs against a hosted
# aggregator, a first-party provider endpoint, or a local vLLM deployment.

WEBPILOT_BASE_URL=https://openrouter.ai/api/v1
WEBPILOT_API_KEY=
WEBPILOT_MODEL=

# Judge model — must be a different, stronger family than the planner.
WEBPILOT_JUDGE_BASE_URL=
WEBPILOT_JUDGE_API_KEY=
WEBPILOT_JUDGE_MODEL=
